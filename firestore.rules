rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Anyone can watch the dashboard.
      allow read: if true;
      // Only your Google account can change anything.
      // Replace the address below with the Google account you will sign in with.
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email == "YOUR_EMAIL_HERE@gmail.com";
    }
  }
}
